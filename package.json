{
  "name": "@gokul-gireesh/thread",
  "version": "1.0.0",
  "description": "A worker thread implimentaion using express like routing",
  "main": "node.js",
  "type": "module",
  "exports": {
    ".": {
      "browser": "./web.js",
      "node": "./node.js",
      "import": {
        "node": "./node.js",
        "default": "./web.js"
      },
      "default": "./node.js"
    }
  },
  "scripts": {
    "postinstall": "node thank.js",
    "build:node": "rollup node.js --file nodeBundle.js --format es -p node-resolve -p commonjs -p terser",
    "build:web": "rollup web.js --file webBundle.js --format es -p node-resolve -p commonjs -p terser",
    "build": "npm run build:node && npm run build:web",
    "test": "node --test test/index.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gokul-Gireesh/thread.git"
  },
  "keywords": [
    "router",
    "worker",
    "thread",
    "master",
    "slave"
  ],
  "author": "Gokul-Gireesh",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Gokul-Gireesh/thread/issues"
  },
  "homepage": "https://github.com/Gokul-Gireesh/thread#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.60.2"
  }
}
